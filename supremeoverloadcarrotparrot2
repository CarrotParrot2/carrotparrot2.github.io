// LAYOUT & INTERACTION (same as original working version, unchanged)
const BW = document.getElementById('book-wrap');
const PL = document.getElementById('page-left');
const PR = document.getElementById('page-right');
const SP = document.getElementById('spine');
const FL = document.getElementById('flip-layer');
const FFI= document.getElementById('ff-inner');
const FBI= document.getElementById('fb-inner');
const LI = document.getElementById('left-inner');
const RI = document.getElementById('right-inner');
const CZBL = document.getElementById('cz-bl');
const CZBR = document.getElementById('cz-br');
const OL = document.getElementById('outside-left');
const OR = document.getElementById('outside-right');
const btnPrev = document.getElementById('btn-prev');
const btnNext = document.getElementById('btn-next');
const pgLabel = document.getElementById('pg-label');
const SPINE_W = 46;
let PW=0, PH=0;

function sizeBook() {
  const vw=window.innerWidth, vh=window.innerHeight;
  const maxW = Math.min(vw*0.88 - SPINE_W, 1400);
  const maxH = vh * 0.90;
  let pw = Math.min(maxW/2, maxH*(500/680));
  pw = Math.max(320, Math.min(pw, 680));
  const ph = Math.round(pw*(680/500));
  PW=pw; PH=ph;
  const totalW = pw*2 + SPINE_W;
  BW.style.width = totalW+'px';
  BW.style.height = ph+'px';
  PL.style.width=pw+'px'; PL.style.height=ph+'px'; PL.style.left='0';
  PR.style.width=pw+'px'; PR.style.height=ph+'px'; PR.style.left=(pw+SPINE_W)+'px';
  SP.style.left=pw+'px'; SP.style.width=SPINE_W+'px';
  FL.style.width=pw+'px'; FL.style.height=ph+'px';
  CZBL.style.width='90px'; CZBL.style.height='90px';
  CZBR.style.width='90px'; CZBR.style.height='90px';
  CZBR.style.right='0'; CZBR.style.left='auto';
  document.documentElement.style.setProperty('--PW', pw+'px');
  document.documentElement.style.setProperty('--PH', ph+'px');
}
function positionControls() {
  const hw = (PW*2+SPINE_W)/2;
  OL.style.right = 'calc(50% + '+(hw+16)+'px)';
  OL.style.left = 'auto';
  OR.style.left  = 'calc(50% + '+(hw+16)+'px)';
  OR.style.right = 'auto';
}
window.addEventListener('resize', ()=>{ sizeBook(); positionControls(); });

let cur=0, flipping=false;
const total=S.length;
const tints=['p0','p1','p2','p3','p4','p5'];
function applyTints(idx){
  tints.forEach(t=>{PL.classList.remove(t);PR.classList.remove(t)});
  PL.classList.add(tints[idx%tints.length]);
  PR.classList.add(tints[(idx+1)%tints.length]);
}
function renderSpread(idx){
  LI.innerHTML=S[idx].l;
  RI.innerHTML=S[idx].r;
  applyTints(idx);
  btnPrev.disabled=(idx===0);
  btnNext.disabled=(idx===total-1);
  const lp=idx===0?'i':String(idx*2-1);
  const rp=idx===0?'ii':String(idx*2);
  pgLabel.textContent='pg. '+lp+' – '+rp;
  bindAll();
}
function flipTo(nextIdx){
  if(flipping||nextIdx<0||nextIdx>=total) return;
  flipping=true;
  const fwd=nextIdx>cur;
  FL.style.display='block';
  FL.style.height=PH+'px';
  FL.style.width=PW+'px';
  FL.style.animation='none';
  FL.style.transform='none';

  const front=document.querySelector('.flip-face-front');
  const back =document.querySelector('.flip-face-back');

  if(fwd){
    FL.style.left=(PW+SPINE_W)+'px';
    FL.style.transformOrigin='left center';
    front.style.borderRadius='0 6px 6px 0';
    back.style.borderRadius='6px 0 0 6px';
    back.style.transform='rotateY(180deg)';
    FFI.innerHTML=S[cur].r;
    FBI.innerHTML=S[nextIdx].l;
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      FL.style.animation='fFwd 0.65s cubic-bezier(0.4,0,0.25,1) forwards';
    }));
  } else {
    FL.style.left='0';
    FL.style.transformOrigin='right center';
    front.style.borderRadius='6px 0 0 6px';
    back.style.borderRadius='0 6px 6px 0';
    back.style.transform='rotateY(-180deg)';
    FFI.innerHTML=S[cur].l;
    FBI.innerHTML=S[nextIdx].r;
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      FL.style.animation='fBack 0.65s cubic-bezier(0.4,0,0.25,1) forwards';
    }));
  }
  FFI.style.padding=FBI.style.padding='36px 38px 30px';

  FL.addEventListener('animationend',function h(){
    FL.removeEventListener('animationend',h);
    FL.style.display='none';
    FL.style.animation='none';
    FL.style.transform='';
    cur=nextIdx;
    renderSpread(cur);
    flipping=false;
  },{once:true});
}
function bindAll(){
  document.querySelectorAll('[data-spread]').forEach(el=>{
    el.addEventListener('click',()=>{const s=parseInt(el.dataset.spread);if(!isNaN(s))flipTo(s);});
  });
  ['contactOpenBtn','contactOpenBtn2'].forEach(id=>{
    const el=document.getElementById(id);
    if(el) el.addEventListener('click',()=>openModal('contactModal'));
  });
  ['uniOpenBtn','uniOpenBtn2'].forEach(id=>{
    const el=document.getElementById(id);
    if(el) el.addEventListener('click',()=>openModal('uniModal'));
  });
  document.querySelectorAll('.pf img').forEach(img=>{
    img.addEventListener('error',function(){this.classList.add('err');});
    img.addEventListener('click',function(){
      if(this.classList.contains('err')) return;
      document.getElementById('lb-img').src=this.src;
      document.getElementById('lb-cap').textContent=this.closest('.pf')?.querySelector('.cap')?.textContent||this.alt;
      document.getElementById('lightbox').classList.add('open');
    });
  });
}
btnNext.addEventListener('click',()=>flipTo(cur+1));
btnPrev.addEventListener('click',()=>flipTo(cur-1));
CZBL.addEventListener('click',()=>flipTo(cur-1));
CZBR.addEventListener('click',()=>flipTo(cur+1));
document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight'||e.key==='ArrowDown') flipTo(cur+1);
  if(e.key==='ArrowLeft' ||e.key==='ArrowUp')   flipTo(cur-1);
  if(e.key==='Escape'){
    closeModal('uniModal'); closeModal('contactModal');
    document.getElementById('lightbox').classList.remove('open');
  }
});
let tx=0;
BW.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;},{passive:true});
BW.addEventListener('touchend',e=>{
  const dx=e.changedTouches[0].clientX-tx;
  if(Math.abs(dx)>50) dx<0?flipTo(cur+1):flipTo(cur-1);
});
document.getElementById('btn-exit').addEventListener('click',()=>{
  const r=document.getElementById('reading');
  const l=document.getElementById('landing');
  r.style.transition='opacity 0.4s';
  r.style.opacity='0';
  setTimeout(()=>{
    r.classList.remove('visible');
    r.style.opacity='';
    r.style.transition='';
    l.style.display='flex';
    l.style.opacity='0';
    l.classList.remove('hidden');
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      l.style.transition='opacity 0.4s';
      l.style.opacity='1';
      setTimeout(()=>{ l.style.transition=''; }, 420);
    }));
    cur=0; renderSpread(0);
  }, 420);
});
document.getElementById('openBookBtn').addEventListener('click',()=>{
  const l=document.getElementById('landing');
  const r=document.getElementById('reading');
  l.style.transition='opacity 0.35s';
  l.style.opacity='0';
  setTimeout(()=>{
    l.classList.add('hidden');
    l.style.opacity='';
    l.style.transition='';
    r.classList.add('visible');
  }, 360);
});
function openModal(id){ document.getElementById(id).classList.add('open'); }
function closeModal(id){ document.getElementById(id).classList.remove('open'); }
document.getElementById('uniClose').addEventListener('click',()=>closeModal('uniModal'));
document.getElementById('contactClose').addEventListener('click',()=>closeModal('contactModal'));
['uniModal','contactModal'].forEach(id=>{
  document.getElementById(id).addEventListener('click',e=>{if(e.target===document.getElementById(id))closeModal(id);});
});
document.querySelectorAll('.uni-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{const u=btn.dataset.url;if(u)window.open(u,'_blank');});
});
document.getElementById('lightbox').addEventListener('click',e=>{
  if(e.target===document.getElementById('lightbox')||e.target===document.getElementById('lb-img'))
    document.getElementById('lightbox').classList.remove('open');
});
// falling leaves (unchanged)
(function(){
  const c=document.getElementById('leaves'),ctx=c.getContext('2d');
  function rsz(){c.width=innerWidth;c.height=innerHeight;} rsz(); addEventListener('resize',rsz);
  const COLS=['#b04828','#c08818','#346820','#a85060','#705888','#488030','#a07010'];
  const SH=[
    (x,s)=>{x.beginPath();x.ellipse(0,0,s*.45,s*.2,0,0,Math.PI*2);x.fill();},
    (x,s)=>{x.beginPath();x.moveTo(0,-s*.45);x.bezierCurveTo(s*.3,-s*.2,s*.35,s*.2,0,s*.45);x.bezierCurveTo(-s*.35,s*.2,-s*.3,-s*.2,0,-s*.45);x.fill();},
    (x,s)=>{x.beginPath();x.moveTo(0,-s*.5);x.quadraticCurveTo(s*.4,0,0,s*.5);x.quadraticCurveTo(-s*.4,0,0,-s*.5);x.fill();}
  ];
  function mk(init){return{x:Math.random()*c.width,y:init?Math.random()*c.height:-20,sz:8+Math.random()*14,sp:.4+Math.random()*.9,dr:(Math.random()-.5)*.6,rot:Math.random()*Math.PI*2,rs:(Math.random()-.5)*.04,sw:Math.random()*Math.PI*2,ss:.01+Math.random()*.015,sa:.4+Math.random()*1,col:COLS[Math.random()*COLS.length|0],a:.3+Math.random()*.28,sh:Math.random()*3|0};}
  let lv=Array.from({length:20},()=>mk(true));
  (function anim(){
    ctx.clearRect(0,0,c.width,c.height);
    lv.forEach(l=>{
      l.sw+=l.ss;l.x+=l.dr+Math.sin(l.sw)*l.sa;l.y+=l.sp;l.rot+=l.rs;
      if(l.y>c.height+20)Object.assign(l,mk(false),{x:Math.random()*c.width});
      ctx.save();ctx.translate(l.x,l.y);ctx.rotate(l.rot);
      ctx.globalAlpha=l.a;ctx.fillStyle=l.col;SH[l.sh](ctx,l.sz);
      ctx.globalAlpha=l.a*.4;ctx.strokeStyle='rgba(0,0,0,.22)';ctx.lineWidth=.5;
      ctx.beginPath();ctx.moveTo(0,-l.sz*.4);ctx.lineTo(0,l.sz*.4);ctx.stroke();
      ctx.restore();
    });
    requestAnimationFrame(anim);
  })();
})();

document.getElementById('outside-left').style.position='absolute';
document.getElementById('outside-right').style.position='absolute';
document.getElementById('outside-left').style.top='50%';
document.getElementById('outside-right').style.top='50%';
document.getElementById('outside-left').style.transform='translateY(-50%)';
document.getElementById('outside-right').style.transform='translateY(-50%)';
sizeBook();
positionControls();
renderSpread(0);
</script>
</body>
</html>
